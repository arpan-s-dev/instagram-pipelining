# Copy to .env or set in your shell. Do not commit real values.

# Instagram username (no @)
IG_USERNAME=your_username

# Optional: full path to tesseract.exe on Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Whisper device: cuda or cpu
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8
